<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="PolySharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\src\GuildSaber.Api\Features\**\*Responses.cs" Link="Routes\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\..\src\GuildSaber.Api\Features\**\*Requests.cs" Link="Routes\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\..\src\GuildSaber.Api\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
        <Compile Remove="..\..\src\GuildSaber.Api\Shared\*Extensions.cs" Link="Shared\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CSharpFunctionalExtensions" />
        <PackageReference Include="System.Net.Http.Json" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\GuildSaber.Common\GuildSaber.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Routes\RankedMaps\MapVersions\" />
    </ItemGroup>

</Project>
