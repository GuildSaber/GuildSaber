<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>CS1591</NoWarn>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.Extensions.Validation.Generated</InterceptorsNamespaces>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GuildSaber.AspireTests" />
    </ItemGroup>

    <PropertyGroup>
        <OpenApiDocumentsDirectory>.</OpenApiDocumentsDirectory>
        <GuildSaberOpenApiDocument>$(MSBuildProjectDirectory)\GuildSaber.Api.json</GuildSaberOpenApiDocument>
    </PropertyGroup>

    <UsingTask TaskName="GuildSaberNormalizeJsonLineEndings"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <FilePath ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var contents = File.ReadAllText(FilePath);
                var normalizedContents = contents
                    .Replace("\\r\\n", "\\n")
                    .Replace("\r\n", "\n")
                    .Replace("\r", "\n");

                if (!string.Equals(contents, normalizedContents, StringComparison.Ordinal))
                    File.WriteAllText(FilePath, normalizedContents, new UTF8Encoding(false));
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="NormalizeOpenApiLineEndings">
        <GuildSaberNormalizeJsonLineEndings FilePath="$(GuildSaberOpenApiDocument)" />
    </Target>

    <Target Name="CopyOpenApiToWebsite"
            AfterTargets="GenerateOpenApiDocuments"
            DependsOnTargets="NormalizeOpenApiLineEndings">
        <PropertyGroup>
            <_WebsiteOpenApiDir>..\GuildSaber.Website\openapi</_WebsiteOpenApiDir>
        </PropertyGroup>
        <MakeDir Directories="$(_WebsiteOpenApiDir)" />
        <Copy SourceFiles="$(GuildSaberOpenApiDocument)"
              DestinationFiles="$(_WebsiteOpenApiDir)\GuildSaber.Api.json"
              SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <PackageReference Include="AspNet.Security.OAuth.Discord" />
        <PackageReference Include="CSharpFunctionalExtensions.HttpResults" />
        <PackageReference Include="LinqKit.Microsoft.EntityFrameworkCore" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
        <PackageReference Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
        <PackageReference Include="MyCSharp.HttpUserAgentParser.AspNetCore" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Scalar.AspNetCore.Microsoft" />
        <PackageReference Include="TickerQ" />
        <PackageReference Include="TickerQ.Dashboard" />
        <PackageReference Include="TickerQ.EntityFrameworkCore" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GuildSaber.Api.Tests" />
        <InternalsVisibleTo Include="GuildSaber.Common.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\aspire\GuildSaber.ServiceDefaults\GuildSaber.ServiceDefaults.csproj" />
        <ProjectReference Include="..\GuildSaber.Database\GuildSaber.Database.csproj" />
    </ItemGroup>
</Project>
