<?xml version="1.0" encoding="utf-8"?>
<Project>

    <!-- Plugin metadata -->
    <PropertyGroup>
        <PluginId>GuildSaber</PluginId>
        <PluginName>GuildSaber</PluginName>
        <PluginHint>GuildSaber.Mod.Plugin</PluginHint>
        <Authors>SheepVand,Kuurama</Authors>
        <Version>0.8.0</Version>
        <GameVersion>1.44.0</GameVersion>
        <Description>The official GuildSaber mod for Beat Saber</Description>
        <ProjectHome>https://github.com/GuildSaber/GuildSaber</ProjectHome>
        <RepositoryUrl>https://github.com/GuildSaber/GuildSaber</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <DependsOn Include="BSIPA" Version="^4.3.6" />
        <DependsOn Include="BS Utils" Version="^1.14.2" />
        <DependsOn Include="ChatPlexSDK_BS" Version=">=6.4.0" />
        <DependsOn Include="SongCore" Version=">=3.14.15" />
        <DependsOn Include="SixLabors.ImageSharp" Version=">=2.0.0" />
        <DependsOn Include="BeatLeader" Version="*" />
    </ItemGroup>

    <PropertyGroup>
        <BSMTProjectType>BSIPA</BSMTProjectType>
        <GenerateManifest>true</GenerateManifest>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' != 'Release'">
        <DisableZipRelease>true</DisableZipRelease>
    </PropertyGroup>

    <ItemGroup>
        <OutputCopy Include="$(OutputPath)\$(TargetFileName)" OutputPath="Plugins\$(TargetFileName)" />
    </ItemGroup>

</Project>
