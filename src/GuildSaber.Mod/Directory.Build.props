<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

    <!-- Plugin Metadata -->
    <PropertyGroup>
        <PluginId>GuildSaber</PluginId>
        <PluginName>GuildSaber</PluginName>
        <PluginHint>GuildSaber.Mod.Plugin</PluginHint>
        <Authors>SheepVand,Kuurama</Authors>
        <Version>0.5.0</Version>
        <GameVersion>1.40.0</GameVersion>
        <Description>The official GuildSaber mod for Beat Saber</Description>
        <ProjectHome>https://github.com/GuildSaber/GuildSaber</ProjectHome>
        <!--<PluginIcon></PluginIcon>-->
        <!--<ProjectSource></ProjectSource>-->
        <!--<DonateUrl></DonateUrl>-->
    </PropertyGroup>

    <!-- Plugin Dependencies -->
    <ItemGroup>
        <DependsOn Include="BSIPA" Version="^4.2.0" />
        <DependsOn Include="ChatPlexSDK_BS" Version="^6.0.0" />
    </ItemGroup>

    <PropertyGroup>
        <BSMTProjectType>BSIPA</BSMTProjectType>
        <GenerateManifest>true</GenerateManifest>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' != 'Release'">
        <DisableZipRelease>true</DisableZipRelease>
    </PropertyGroup>

    <ItemGroup>
        <OutputCopy Include="$(OutputPath)\*.dll" Exclude="$(OutputPath)\$(TargetFileName)" OutputPath="Libs\%(Filename)%(Extension)" />
        <OutputCopy Include="$(OutputPath)\$(TargetFileName)" OutputPath="Plugins\$(TargetFileName)" />
        <OutputCopy Include="$(OutputPath)\$(TargetName).pdb" OutputPath="Plugins\$(TargetName).pdb" />
    </ItemGroup>

</Project>
